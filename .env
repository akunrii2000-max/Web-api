# ── MikuAI DB (WAJIB) ────────────────────────
DTDB_URL=https://dongtube.my.id
DTDB_API_KEY=your_api_key_here

# ── Server ───────────────────────────────────
PORT=3000
NODE_ENV=production
TOKEN_SECRET=mikuai_secret_change_this

# ── Admin ────────────────────────────────────
ADMIN_PASS=ganti_password_ini
ADMIN_PATH=admin

# ── API Key Auth (wajib untuk semua endpoint) ─
# Pisahkan beberapa key dengan koma, contoh: key1,key2,key3
MIKUAI_API_KEYS=demo_key_123,ganti_api_key_ini

# ── Rate Limit ───────────────────────────────
FREE_API_RATE_LIMIT=15
FREE_API_RATE_WINDOW=60000

# ── CDN (opsional) ───────────────────────────
CDN_MAX_SIZE_MB=100
CORS_ORIGIN=*
DTDB_TIMEOUT_MS=30000
